          <ipd:source key="FDA-PD24" loc="SIII.B.1" page="printed 6; lines 194-198"/>
          <ipd:req id="REQ-066"/>
          <ipd:req id="REQ-067"/>
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
          <ipd:verify>[verify] E6(R3) does not label premature unblinding a protocol deviation; trial-specific criteria decide (R1 C13)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_02_F20</bpmn:incoming>
      <bpmn:outgoing>L4_02_F24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="L4_02_G4" name="Which additional reports are due?" gatewayDirection="Diverging" default="L4_02_F21">
      <bpmn:documentation textFormat="text/plain">Justification: Every deviation is reported to the sponsor (A14, before the split: deviation report, FDA-PD24 SIII.B.1, DRAFT, including the premature unblinding explanation, E6R3 A1-2.11). One deviation can in addition require the computerised system incident report (E6R3 A1-2.12.10(e)) and, in the EU, the suspected serious breach report (EMA-SB S6.4); both can apply together (FLW-07, DEC-02). Default flow 'No further report' to the OR join when neither applies.</bpmn:documentation>
      <bpmn:incoming>L4_02_F24</bpmn:incoming>
      <bpmn:outgoing>L4_02_F21</bpmn:outgoing>
      <bpmn:outgoing>L4_02_F22</bpmn:outgoing>
      <bpmn:outgoing>L4_02_F23</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="L4_02_A15" name="Report computerised system incident">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.12.10(e) (p. printed 22 / PDF 30)
Requirements: REQ-068
Binding: binding-ICH
Jurisdiction: ICH
Party: investigator/institution</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" party="investigator/institution">
          <ipd:source key="E6R3" loc="A1-2.12.10(e)" page="printed 22 / PDF 30"/>
          <ipd:req id="REQ-068"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_02_F22</bpmn:incoming>
      <bpmn:outgoing>L4_02_F25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L4_02_A16" name="Report suspected serious breach to sponsor">
      <bpmn:documentation textFormat="text/plain">Sources: EMA-SB S6.4 (p. printed 9-10/21)
Requirements: REQ-069
Binding: guidance
Jurisdiction: EU
Deadline: promptly
Record: site process / SOP
Party: Principal Investigator</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="guidance" jurisdiction="EU" deadline="promptly" record="site process / SOP" party="Principal Investigator">
          <ipd:source key="EMA-SB" loc="S6.4" page="printed 9-10/21"/>
          <ipd:req id="REQ-069"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>L4_02_GR_EU_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_02_F23</bpmn:incoming>
      <bpmn:outgoing>L4_02_F26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="L4_02_G5" gatewayDirection="Converging">
      <bpmn:incoming>L4_02_F21</bpmn:incoming>
      <bpmn:incoming>L4_02_F25</bpmn:incoming>
      <bpmn:incoming>L4_02_F26</bpmn:incoming>
      <bpmn:outgoing>L4_02_F27</bpmn:outgoing>
    </bpmn:inclusiveGateway>
