          <ipd:source key="E6R3" loc="P3.1" page="printed 4 / PDF 12"/>
          <ipd:source key="E6R3" loc="A1-3.9.2" page="printed 26 / PDF 34"/>
          <ipd:source key="E6R3" loc="P10.1" page="printed 7 / PDF 15"/>
          <ipd:source key="E6R3" loc="P10.3" page="printed 7 / PDF 15"/>
          <ipd:source key="E6R3" loc="A1-3.9.5" page="printed 27 / PDF 35"/>
          <ipd:source key="E6R3" loc="A2-3.8" page="printed 62 / PDF 70"/>
          <ipd:source key="EMA-SB" loc="SGlossary" page="printed 3/21"/>
          <ipd:source key="TCB-RBQM" loc="SQTL-Process" page="journal pp. 251-261 (section page not confirmed)"/>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="L4_08_P_INV" name="Investigator/institution" processRef="L4_08_P_INV_PROCESS">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 GL:Investigator (p. printed 87 / PDF 95); EUCTR Art. 2(2)(15) (p. OJ L 158/13); 21CFR312 21CFR312.60 (p. n/a - eCFR web text without pagination); EUCTR Art. 47 (p. OJ L 158/39); E6R3 P3.1 (p. printed 4 / PDF 12); E6R3 A1-2.5.2 (p. printed 13 / PDF 21); E6R3 A1-2.10.6 (p. printed 20 / PDF 28); E6R3 A1-2.3.1 (p. printed 12 / PDF 20); E6R3 A2-2.4 (p. printed 55 / PDF 63); E6R3 A2-2.4.1 (p. printed 56 / PDF 64)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace>
          <ipd:source key="E6R3" loc="GL:Investigator" page="printed 87 / PDF 95"/>
          <ipd:source key="EUCTR" loc="Art. 2(2)(15)" page="OJ L 158/13"/>
          <ipd:source key="21CFR312" loc="21CFR312.60" page="n/a - eCFR web text without pagination"/>
