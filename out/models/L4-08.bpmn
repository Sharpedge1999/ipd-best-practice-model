          <ipd:source key="E6R3" loc="A1-2.10.6" page="printed 20 / PDF 28"/>
          <ipd:source key="E6R3" loc="A1-2.3.1" page="printed 12 / PDF 20"/>
          <ipd:source key="E6R3" loc="A2-2.4" page="printed 55 / PDF 63"/>
          <ipd:source key="E6R3" loc="A2-2.4.1" page="printed 56 / PDF 64"/>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:participant>
    <bpmn:participant id="L4_08_P_IEC" name="IRB/IEC">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 GL:Institutional Review Board (IRB)/Independent Ethics Committee (IEC) (p. printed 87 / PDF 95); EUCTR Art. 2(2)(11) (p. OJ L 158/12); 21CFR56 21CFR56.108(b)(2) (p. n/a - eCFR web text without pagination)</bpmn:documentation>
