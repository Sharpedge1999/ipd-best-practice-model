    <bpmn:sequenceFlow id="L4_08_F2" sourceRef="L4_08_A1" targetRef="L4_08_A2"/>
    <bpmn:sequenceFlow id="L4_08_F3" sourceRef="L4_08_A2" targetRef="L4_08_A3"/>
    <bpmn:sequenceFlow id="L4_08_F4" sourceRef="L4_08_A3" targetRef="L4_08_G1"/>
    <bpmn:sequenceFlow id="L4_08_F5" name="Yes" sourceRef="L4_08_G1" targetRef="L4_08_A4"/>
