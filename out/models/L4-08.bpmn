    <bpmn:group id="L4_08_GR_EU" categoryValueRef="L4_08_GR_EU_VALUE"/>
    <bpmn:group id="L4_08_GR_EU2" categoryValueRef="L4_08_GR_EU2_VALUE"/>
    <bpmn:group id="L4_08_GR_US" categoryValueRef="L4_08_GR_US_VALUE"/>
  </bpmn:collaboration>
  <bpmn:process id="L4_08_P_SPON_PROCESS" name="Sponsor" isExecutable="false">
    <bpmn:documentation textFormat="text/plain">Request-driven hand-off 'Archived records made available on request' (EU CTR Art. 58; E6R3 AppC-C.2.6) is shown as data stores D1 'Trial master file' and D2 'Investigator site file' (glossary terms) with sources instead of a message flow, as l3_cut allows; REQ-192 and REQ-196 are on tasks A3 and A4.
Investigator jurisdiction groups: A7 is in GR_EU2 and A8 in GR_US (separate group ids because a group must cover adjacent members only).
C-23: US sponsor retention under 21 CFR 312.57 was not extracted; listed in open_items.</bpmn:documentation>
    <bpmn:laneSet id="L4_08_P_SPON_LANESET">
      <bpmn:lane id="L4_08_L_SPON" name="Sponsor">
        <bpmn:documentation textFormat="text/plain">Sources: E6R3 GL:Sponsor (p. printed 90 / PDF 98); EUCTR Art. 2(2)(14) (p. OJ L 158/12); 21CFR312 21CFR312.50 (p. n/a - eCFR web text without pagination)</bpmn:documentation>
        <bpmn:extensionElements>
          <ipd:trace>
            <ipd:source key="E6R3" loc="GL:Sponsor" page="printed 90 / PDF 98"/>
            <ipd:source key="EUCTR" loc="Art. 2(2)(14)" page="OJ L 158/12"/>
            <ipd:source key="21CFR312" loc="21CFR312.50" page="n/a - eCFR web text without pagination"/>
          </ipd:trace>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>L4_08_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_08_E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="L4_08_S1" name="iPDs reported in clinical study report">
      <bpmn:outgoing>L4_08_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="L4_08_A1" name="Archive important and non-important protocol deviations">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 AppC-C.3.2 (p. printed 81 / PDF 89; printed 78-79 / PDF 86-87); E6R3 AppC-C.3.1(r) (p. printed 78 / PDF 86); E6R3 GL:Essential Records (p. printed 85-86 / PDF 93-94); TCB-PD-TIRS SClose-Out (p. journal pp. 733-742 (section page not confirmed; PMC HTML read)); TCB-PD-TIRS SStore (p. journal pp. 733-742 (section page not confirmed; PMC HTML read))
Requirements: REQ-188, REQ-200, REQ-201
Binding: binding-ICH
Jurisdiction: ICH
Deadline: retention period per applicable regulatory requirements
Record: deviation and noncompliance records; CAPA records; validated repository; SDTM deviation dataset; PDAP
Party: sponsor and investigator/institution
Verify: [verify] duty of 'sponsor and investigator/institution'; applies in both pools; [verify] single fetch (R5-033)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="retention period per applicable regulatory requirements" record="deviation and noncompliance records; CAPA records; validated repository; SDTM deviation dataset; PDAP" party="sponsor and investigator/institution">
          <ipd:source key="E6R3" loc="AppC-C.3.2" page="printed 81 / PDF 89; printed 78-79 / PDF 86-87"/>
          <ipd:source key="E6R3" loc="AppC-C.3.1(r)" page="printed 78 / PDF 86"/>
          <ipd:source key="E6R3" loc="GL:Essential Records" page="printed 85-86 / PDF 93-94"/>
          <ipd:source key="TCB-PD-TIRS" loc="SClose-Out" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)"/>
          <ipd:source key="TCB-PD-TIRS" loc="SStore" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)"/>
          <ipd:req id="REQ-188"/>
          <ipd:req id="REQ-200"/>
          <ipd:req id="REQ-201"/>
          <ipd:verify>[verify] duty of 'sponsor and investigator/institution'; applies in both pools</ipd:verify>
          <ipd:verify>[verify] single fetch (R5-033)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_08_F1</bpmn:incoming>
      <bpmn:outgoing>L4_08_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L4_08_A2" name="Retain related essential records">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 AppC-C.3.2 (p. printed 81 / PDF 89; printed 79 / PDF 87); E6R3 AppC-C.3.1(a) (p. printed 77 / PDF 85); E6R3 AppC-C.3.1(s) (p. printed 78 / PDF 86); E6R3 A1-3.16.3(a) (p. printed 43 / PDF 51); E6R3 P9.5 (p. printed 6 / PDF 14); E6R3 A1-4.2.7 (p. printed 48 / PDF 56)
Requirements: REQ-189, REQ-190, REQ-193
Binding: binding-ICH
Jurisdiction: ICH
Deadline: retention period per applicable regulatory requirements (REQ-189); per applicable regulatory requirements (REQ-190); throughout the retention period (REQ-193)
Record: essential records (Appendix C); sponsor-specific essential records; archived data and metadata
Party: sponsor; sponsor and investigator/institution; sponsors and investigators; responsible party</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="retention period per applicable regulatory requirements (REQ-189); per applicable regulatory requirements (REQ-190); throughout the retention period (REQ-193)" record="essential records (Appendix C); sponsor-specific essential records; archived data and metadata" party="sponsor; sponsor and investigator/institution; sponsors and investigators; responsible party">
          <ipd:source key="E6R3" loc="AppC-C.3.2" page="printed 81 / PDF 89; printed 79 / PDF 87"/>
          <ipd:source key="E6R3" loc="AppC-C.3.1(a)" page="printed 77 / PDF 85"/>
          <ipd:source key="E6R3" loc="AppC-C.3.1(s)" page="printed 78 / PDF 86"/>
          <ipd:source key="E6R3" loc="A1-3.16.3(a)" page="printed 43 / PDF 51"/>
          <ipd:source key="E6R3" loc="P9.5" page="printed 6 / PDF 14"/>
          <ipd:source key="E6R3" loc="A1-4.2.7" page="printed 48 / PDF 56"/>
          <ipd:req id="REQ-189"/>
          <ipd:req id="REQ-190"/>
          <ipd:req id="REQ-193"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_08_F2</bpmn:incoming>
      <bpmn:outgoing>L4_08_F3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="L4_08_D1_A2_OUT">
        <bpmn:targetRef>L4_08_D1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="L4_08_A3" name="Keep records accessible">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 AppC-C.2.6 (p. printed 76 / PDF 84)
Requirements: REQ-192
Binding: binding-ICH
Jurisdiction: ICH
Record: essential records
Party: sponsor and investigator/institution</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" record="essential records" party="sponsor and investigator/institution">
          <ipd:source key="E6R3" loc="AppC-C.2.6" page="printed 76 / PDF 84"/>
          <ipd:req id="REQ-192"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_08_F3</bpmn:incoming>
      <bpmn:outgoing>L4_08_F4</bpmn:outgoing>
      <bpmn:property id="L4_08_A3_PROPERTY" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="L4_08_D1_A3_IN">
        <bpmn:sourceRef>L4_08_D1</bpmn:sourceRef>
        <bpmn:targetRef>L4_08_A3_PROPERTY</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="L4_08_G1" name="EU CTR applies?" gatewayDirection="Diverging">
      <bpmn:categoryValueRef>L4_08_GR_EU_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_08_F4</bpmn:incoming>
      <bpmn:outgoing>L4_08_F5</bpmn:outgoing>
      <bpmn:outgoing>L4_08_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="L4_08_A4" name="Archive content of clinical trial master file">
      <bpmn:documentation textFormat="text/plain">Sources: EUCTR Art. 58 (p. OJ L 158/41); EUCTR Art. 2(2)(26) (p. OJ L 158/13)
Requirements: REQ-194, REQ-196, REQ-197, REQ-198
Binding: binding-law
Jurisdiction: EU
Deadline: at least 25 years after the end of the trial (REQ-194); for the archiving period (REQ-196)
Record: archived clinical trial master file (sponsor); archived clinical trial master file; archive responsibility assignment; audit trail of master file changes
Party: The sponsor</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="EU" deadline="at least 25 years after the end of the trial (REQ-194); for the archiving period (REQ-196)" record="archived clinical trial master file (sponsor); archived clinical trial master file; archive responsibility assignment; audit trail of master file changes" party="The sponsor">
          <ipd:source key="EUCTR" loc="Art. 58" page="OJ L 158/41"/>
          <ipd:source key="EUCTR" loc="Art. 2(2)(26)" page="OJ L 158/13"/>
          <ipd:req id="REQ-194"/>
          <ipd:req id="REQ-196"/>
          <ipd:req id="REQ-197"/>
          <ipd:req id="REQ-198"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>L4_08_GR_EU_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_08_F5</bpmn:incoming>
      <bpmn:outgoing>L4_08_F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="L4_08_G2" gatewayDirection="Converging">
      <bpmn:categoryValueRef>L4_08_GR_EU_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_08_F6</bpmn:incoming>
      <bpmn:incoming>L4_08_F7</bpmn:incoming>
      <bpmn:outgoing>L4_08_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="L4_08_A5" name="Capture deviation lessons learned">
      <bpmn:documentation textFormat="text/plain">Sources: TCB-PD STaking-a-holistic-approach-CLOSEOUT (p. web page (carousel tab CLOSEOUT)); TCB-PD-TIRS SClose-Out (p. journal pp. 733-742 (section page not confirmed; PMC HTML read)); TCB-PD-TIRS SDefine (p. journal pp. 733-742 (section page not confirmed; PMC HTML read))
Requirements: REQ-202
Binding: best-practice
Jurisdiction: ICH
Record: lessons learned record; organisation-level iPD definitions
Verify: [verify] single fetch (R5-006)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="best-practice" jurisdiction="ICH" record="lessons learned record; organisation-level iPD definitions">
          <ipd:source key="TCB-PD" loc="STaking-a-holistic-approach-CLOSEOUT" page="web page (carousel tab CLOSEOUT)"/>
          <ipd:source key="TCB-PD-TIRS" loc="SClose-Out" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)"/>
          <ipd:source key="TCB-PD-TIRS" loc="SDefine" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)"/>
          <ipd:req id="REQ-202"/>
          <ipd:verify>[verify] single fetch (R5-006)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_08_F8</bpmn:incoming>
      <bpmn:outgoing>L4_08_F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="L4_08_E1" name="Deviation records archived">
      <bpmn:incoming>L4_08_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="L4_08_D1" name="Trial master file" dataStoreRef="L4_08_D1_STORE">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 AppC-C.2.3 (p. printed 75 / PDF 83); E6R3 AppC-C.2.6 (p. printed 76 / PDF 84); EUCTR Art. 58 (p. OJ L 158/41)
Verify: [verify] directly accessible on request by regulatory authorities (E6R3 AppC-C.2.6; EU CTR Art. 58); request-driven hand-off shown as data store, not as message flow</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace>
          <ipd:source key="E6R3" loc="AppC-C.2.3" page="printed 75 / PDF 83"/>
          <ipd:source key="E6R3" loc="AppC-C.2.6" page="printed 76 / PDF 84"/>
          <ipd:source key="EUCTR" loc="Art. 58" page="OJ L 158/41"/>
          <ipd:verify>[verify] directly accessible on request by regulatory authorities (E6R3 AppC-C.2.6; EU CTR Art. 58); request-driven hand-off shown as data store, not as message flow</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:dataStoreReference>
