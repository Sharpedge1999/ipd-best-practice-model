    <bpmn:messageFlow id="L4_08_M1" name="Records no longer needed notified" sourceRef="L4_08_A3" targetRef="L4_08_A6">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.12.11 (p. printed 22 / PDF 30); E6R3 A1-2.12.12 (p. printed 23 / PDF 31); E6R3 AppC-C.1.3 (p. printed 75 / PDF 83)
Requirements: REQ-191
Binding: binding-ICH
Jurisdiction: ICH
Deadline: longest of the required period or sponsor notice
Party: sponsor; investigator/institution</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="longest of the required period or sponsor notice" party="sponsor; investigator/institution">
          <ipd:source key="E6R3" loc="A1-2.12.11" page="printed 22 / PDF 30"/>
          <ipd:source key="E6R3" loc="A1-2.12.12" page="printed 23 / PDF 31"/>
          <ipd:source key="E6R3" loc="AppC-C.1.3" page="printed 75 / PDF 83"/>
