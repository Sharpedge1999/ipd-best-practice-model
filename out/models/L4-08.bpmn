  <bpmn:process id="L4_08_P_INV_PROCESS" name="Investigator/institution" isExecutable="false">
    <bpmn:startEvent id="L4_08_S2" name="End of clinical trial reached">
      <bpmn:outgoing>L4_08_F10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="L4_08_A6" name="Retain investigator essential records">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.12.11 (p. printed 22 / PDF 30); E6R3 A1-2.12.12 (p. printed 23 / PDF 31); E6R3 AppC-C.1.3 (p. printed 75 / PDF 83); E6R3 AppC-C.3.2 (p. printed 81 / PDF 89; printed 78-79 / PDF 86-87); E6R3 AppC-C.3.1(r) (p. printed 78 / PDF 86); E6R3 GL:Essential Records (p. printed 85-86 / PDF 93-94)
Requirements: REQ-191, REQ-188
Binding: binding-ICH
Jurisdiction: ICH
Deadline: longest of the required period or sponsor notice (REQ-191); retention period per applicable regulatory requirements (REQ-188)
Record: investigator/institution essential records; deviation and noncompliance records; CAPA records
Party: investigator/institution; sponsor and investigator/institution
Verify: [verify] duty of 'sponsor and investigator/institution'; applies in both pools</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="longest of the required period or sponsor notice (REQ-191); retention period per applicable regulatory requirements (REQ-188)" record="investigator/institution essential records; deviation and noncompliance records; CAPA records" party="investigator/institution; sponsor and investigator/institution">
          <ipd:source key="E6R3" loc="A1-2.12.11" page="printed 22 / PDF 30"/>
          <ipd:source key="E6R3" loc="A1-2.12.12" page="printed 23 / PDF 31"/>
          <ipd:source key="E6R3" loc="AppC-C.1.3" page="printed 75 / PDF 83"/>
          <ipd:source key="E6R3" loc="AppC-C.3.2" page="printed 81 / PDF 89; printed 78-79 / PDF 86-87"/>
          <ipd:source key="E6R3" loc="AppC-C.3.1(r)" page="printed 78 / PDF 86"/>
          <ipd:source key="E6R3" loc="GL:Essential Records" page="printed 85-86 / PDF 93-94"/>
          <ipd:req id="REQ-191"/>
          <ipd:req id="REQ-188"/>
          <ipd:verify>[verify] duty of 'sponsor and investigator/institution'; applies in both pools</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_08_F10</bpmn:incoming>
      <bpmn:outgoing>L4_08_F11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="L4_08_D2_A6_OUT">
        <bpmn:targetRef>L4_08_D2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:inclusiveGateway id="L4_08_G3" name="Which retention rules apply?" gatewayDirection="Diverging" default="L4_08_F14">
      <bpmn:documentation textFormat="text/plain">Justification: EU CTR Art. 58 (25 years) and 21 CFR 312.62(c) (2 years) can apply to the same trial; the investigator applies every applicable rule and keeps records for the longest period (E6R3 A1-2.12.12), so the branches are not exclusive (FLW-07, DEC-02). Default flow 'Neither' when only the ICH rule applies.</bpmn:documentation>
      <bpmn:incoming>L4_08_F11</bpmn:incoming>
      <bpmn:outgoing>L4_08_F12</bpmn:outgoing>
      <bpmn:outgoing>L4_08_F13</bpmn:outgoing>
      <bpmn:outgoing>L4_08_F14</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="L4_08_A7" name="Archive content of clinical trial master file">
      <bpmn:documentation textFormat="text/plain">Sources: EUCTR Art. 58 (p. OJ L 158/41)
Requirements: REQ-195
Binding: binding-law
Jurisdiction: EU
Deadline: at least 25 years after the end of the trial
Record: archived clinical trial master file (investigator)
Party: the investigator</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="EU" deadline="at least 25 years after the end of the trial" record="archived clinical trial master file (investigator)" party="the investigator">
          <ipd:source key="EUCTR" loc="Art. 58" page="OJ L 158/41"/>
          <ipd:req id="REQ-195"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>L4_08_GR_EU2_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_08_F12</bpmn:incoming>
      <bpmn:outgoing>L4_08_F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L4_08_A8" name="Retain investigator records for 2 years">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.62(c) (p. n/a - eCFR web text without pagination)
Requirements: REQ-199
Binding: binding-law
Jurisdiction: US
Deadline: 2 years after approval, or 2 years after discontinuation and FDA notification
Record: investigator records (21 CFR 312.62)
Party: investigator</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="US" deadline="2 years after approval, or 2 years after discontinuation and FDA notification" record="investigator records (21 CFR 312.62)" party="investigator">
          <ipd:source key="21CFR312" loc="21CFR312.62(c)" page="n/a - eCFR web text without pagination"/>
          <ipd:req id="REQ-199"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>L4_08_GR_US_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_08_F13</bpmn:incoming>
      <bpmn:outgoing>L4_08_F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="L4_08_G4" gatewayDirection="Converging">
      <bpmn:incoming>L4_08_F14</bpmn:incoming>
      <bpmn:incoming>L4_08_F15</bpmn:incoming>
      <bpmn:incoming>L4_08_F16</bpmn:incoming>
      <bpmn:outgoing>L4_08_F17</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="L4_08_E2" name="Investigator records archived">
      <bpmn:incoming>L4_08_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="L4_08_D2" name="Investigator site file" dataStoreRef="L4_08_D2_STORE">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 AppC-C.2.3 (p. printed 75 / PDF 83); E6R3 AppC-C.2.6 (p. printed 76 / PDF 84)
Verify: [verify] directly accessible on request by regulatory authorities (E6R3 AppC-C.2.6; EU CTR Art. 58); request-driven hand-off shown as data store, not as message flow</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace>
          <ipd:source key="E6R3" loc="AppC-C.2.3" page="printed 75 / PDF 83"/>
          <ipd:source key="E6R3" loc="AppC-C.2.6" page="printed 76 / PDF 84"/>
          <ipd:verify>[verify] directly accessible on request by regulatory authorities (E6R3 AppC-C.2.6; EU CTR Art. 58); request-driven hand-off shown as data store, not as message flow</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="L4_08_F10" sourceRef="L4_08_S2" targetRef="L4_08_A6"/>
    <bpmn:sequenceFlow id="L4_08_F11" sourceRef="L4_08_A6" targetRef="L4_08_G3"/>
