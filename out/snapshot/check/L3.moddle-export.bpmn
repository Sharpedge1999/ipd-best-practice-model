        <bpmn:flowNodeRef>L3_A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L3_E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="L3_S1" name="CtQ factors identified">
