    <bpmn:task id="L4_05_A8" name="Inform IRB/IEC of significant changes">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.4.6 (p. printed 13 / PDF 21); E6R3 A1-1.4.8(b) (p. printed 11 / PDF 19)
Requirements: REQ-120
Binding: binding-ICH
Jurisdiction: ICH
Deadline: promptly
Party: investigator or sponsor; investigator/institution
Verify: [verify] E6(R3) does not state whether a protocol deviation counts as such a 'change' (C-03); [verify] duty may lie with investigator or sponsor (A1-2.4.6)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="promptly" party="investigator or sponsor; investigator/institution">
          <ipd:source key="E6R3" loc="A1-2.4.6" page="printed 13 / PDF 21"/>
          <ipd:source key="E6R3" loc="A1-1.4.8(b)" page="printed 11 / PDF 19"/>
          <ipd:req id="REQ-120"/>
          <ipd:verify>[verify] E6(R3) does not state whether a protocol deviation counts as such a 'change' (C-03)</ipd:verify>
          <ipd:verify>[verify] duty may lie with investigator or sponsor (A1-2.4.6)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_05_F29</bpmn:incoming>
      <bpmn:outgoing>L4_05_F30</bpmn:outgoing>
    </bpmn:task>
