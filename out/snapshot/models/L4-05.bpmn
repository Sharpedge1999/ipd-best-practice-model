    <bpmn:messageFlow id="L4_05_M1" name="Serious breach notified" sourceRef="L4_05_A2" targetRef="L4_05_P_RA">
      <bpmn:documentation textFormat="text/plain">Sources: EUCTR Art. 52(1) (p. OJ L 158/40); EMA-SB S3.2 (p. printed 5/21); EUCTR-QA S11.3 (p. printed 1-2 (chapter 11)); EMA-SB S3.1 (p. printed 5/21); EUCTR-QA S1.5 (p. printed 4-5 (chapter 1; page numbers restart per chapter)); CTIS-BT-SB24 SSlide-20 (p. slide 20; notification type label on an unnumbered CTCG slide); EMA-SB S8 (p. printed 10/21); CTIS-BT-SB24 SPublication (p. publication section (slides unnumbered)); CTIS-TM17 S2.5 (p. printed 6-10 (Q&amp;A 1.4, 2.5, 2.10)); CTIS-TM17 S4.7 (p. printed 13-14)
Requirements: REQ-111, REQ-231
Binding: binding-law
Jurisdiction: EU
Deadline: without undue delay, at the latest 7 (calendar) days from sponsor awareness of the potential breach
Party: sponsor; Member States concerned
Verify: [verify] whose awareness (delegated party, CRO, monitor) starts the clock is not defined (C-05); [verify] 'seven days' (Art. 52(1)) read as calendar days per EMA-SB S3.2 (C-13)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="EU" deadline="without undue delay, at the latest 7 (calendar) days from sponsor awareness of the potential breach" party="sponsor; Member States concerned">
          <ipd:source key="EUCTR" loc="Art. 52(1)" page="OJ L 158/40"/>
          <ipd:source key="EMA-SB" loc="S3.2" page="printed 5/21"/>
          <ipd:source key="EUCTR-QA" loc="S11.3" page="printed 1-2 (chapter 11)"/>
          <ipd:source key="EMA-SB" loc="S3.1" page="printed 5/21"/>
          <ipd:source key="EUCTR-QA" loc="S1.5" page="printed 4-5 (chapter 1; page numbers restart per chapter)"/>
          <ipd:source key="CTIS-BT-SB24" loc="SSlide-20" page="slide 20; notification type label on an unnumbered CTCG slide"/>
          <ipd:source key="EMA-SB" loc="S8" page="printed 10/21"/>
          <ipd:source key="CTIS-BT-SB24" loc="SPublication" page="publication section (slides unnumbered)"/>
          <ipd:source key="CTIS-TM17" loc="S2.5" page="printed 6-10 (Q&amp;A 1.4, 2.5, 2.10)"/>
          <ipd:source key="CTIS-TM17" loc="S4.7" page="printed 13-14"/>
          <ipd:req id="REQ-111"/>
          <ipd:req id="REQ-231"/>
          <ipd:verify>[verify] whose awareness (delegated party, CRO, monitor) starts the clock is not defined (C-05)</ipd:verify>
          <ipd:verify>[verify] 'seven days' (Art. 52(1)) read as calendar days per EMA-SB S3.2 (C-13)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
