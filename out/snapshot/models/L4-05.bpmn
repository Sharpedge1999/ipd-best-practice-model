    </bpmn:exclusiveGateway>
    <bpmn:task id="L4_05_A9" name="Report changes in research activity to IRB">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.66 (p. n/a - eCFR web text without pagination); 21CFR312 21CFR312.53(c)(1)(vii) (p. n/a - eCFR web text without pagination)
Requirements: REQ-121
Binding: binding-law
Jurisdiction: US
Deadline: promptly (no day count)
Record: IRB report
Party: investigator
Verify: [verify] 21 CFR does not state whether a protocol deviation is a 'change in the research activity'; IRB written procedures decide (C-03)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="US" deadline="promptly (no day count)" record="IRB report" party="investigator">
          <ipd:source key="21CFR312" loc="21CFR312.66" page="n/a - eCFR web text without pagination"/>
          <ipd:source key="21CFR312" loc="21CFR312.53(c)(1)(vii)" page="n/a - eCFR web text without pagination"/>
          <ipd:req id="REQ-121"/>
          <ipd:verify>[verify] 21 CFR does not state whether a protocol deviation is a 'change in the research activity'; IRB written procedures decide (C-03)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>L4_05_GR_US_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_05_F25</bpmn:incoming>
      <bpmn:outgoing>L4_05_F27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L4_05_A10" name="Submit iPD to IRB">
      <bpmn:documentation textFormat="text/plain">Sources: FDA-PD24 SIII.B.3 (p. printed 10; lines 351-353; printed 10; lines 355-356)
Requirements: REQ-122, REQ-123
Binding: guidance
Jurisdiction: US
Deadline: when identified, where possible (REQ-122); not immediately; IRB procedures decide (REQ-123)
Record: IRB submission
Party: the investigator
Draft: DRAFT guidance
Verify: [verify] basis is draft guidance only - shown as DRAFT, never a binding step</bpmn:documentation>
