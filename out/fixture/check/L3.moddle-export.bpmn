          </ipd:trace>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>L3_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L3_A1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3_L_SPON" name="FIXTURE - Sponsor">
