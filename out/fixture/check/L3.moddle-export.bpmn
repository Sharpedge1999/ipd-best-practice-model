    <bpmn:sequenceFlow id="L3_F4" sourceRef="L3_A3" targetRef="L3_E1" />
  </bpmn:process>
  <bpmn:process id="L3_P_INV_PROCESS" name="FIXTURE - Investigator/institution" isExecutable="false">
