      </bpmn:extensionElements>
      <bpmn:incoming>L3_F2</bpmn:incoming>
      <bpmn:outgoing>L3_F3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="L3_A3" name="FIXTURE - Report protocol deviations in CSR" calledElement="L4_03_P_SPON_PROCESS">
      <bpmn:documentation>Sources: E3 FIXTURE
Requirements: REQ-903
Binding: binding-ICH
Jurisdiction: ICH</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH">
          <ipd:source key="E3" loc="FIXTURE" />
          <ipd:req id="REQ-903" />
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L3_F3</bpmn:incoming>
      <bpmn:outgoing>L3_F4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="L3_E1" name="FIXTURE - Protocol deviations reported">
      <bpmn:incoming>L3_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="L3_F1" sourceRef="L3_S1" targetRef="L3_A1" />
    <bpmn:sequenceFlow id="L3_F2" sourceRef="L3_A1" targetRef="L3_A2" />
