      </bpmn:extensionElements>
      <bpmn:incoming>L3_F1</bpmn:incoming>
      <bpmn:outgoing>L3_F2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="L3_A2" name="FIXTURE - Assess protocol deviations" calledElement="L4_02_P_SPON_PROCESS">
      <bpmn:documentation>Sources: E8R1 FIXTURE
Requirements: REQ-902
Binding: binding-ICH
Jurisdiction: ICH</bpmn:documentation>
