<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ipd="urn:ipd-best-practice:trace:1.0" id="IPD_DEFINITIONS" targetNamespace="urn:ipd-best-practice:model" exporter="ipd spec2bpmn" exporterVersion="1.0">
  <bpmn:collaboration id="L3_COLLAB" name="FIXTURE - iPD management overview">
    <bpmn:documentation>Model: L3
Title: FIXTURE - iPD management overview
Rule exception: ROL-03 P_INV - FIXTURE - D1: investigator obligations appear as tasks in an expanded pool
Open item: [verify] FIXTURE - placeholder open item</bpmn:documentation>
    <bpmn:participant id="L3_P_SPON" name="FIXTURE - Sponsor" processRef="L3_P_SPON_PROCESS" />
    <bpmn:participant id="L3_P_INV" name="FIXTURE - Investigator/institution" processRef="L3_P_INV_PROCESS" />
    <bpmn:participant id="L3_P_IEC" name="FIXTURE - IRB/IEC" />
    <bpmn:participant id="L3_P_RA" name="FIXTURE - Regulatory authority" />
    <bpmn:messageFlow id="L3_M1" name="FIXTURE - Deviation report" sourceRef="L3_A4" targetRef="L3_S1">
      <bpmn:documentation>Sources: E6R3 FIXTURE
Requirements: REQ-904
Binding: binding-ICH
Jurisdiction: ICH</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH">
          <ipd:source key="E6R3" loc="FIXTURE" />
          <ipd:req id="REQ-904" />
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M2" name="FIXTURE - Deviation notification" sourceRef="L3_A1" targetRef="L3_P_RA">
      <bpmn:documentation>Sources: EUCTR FIXTURE
Requirements: REQ-905
Binding: binding-law
Jurisdiction: EU
Deadline: xx days (FIXTURE)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="EU" deadline="xx days (FIXTURE)">
          <ipd:source key="EUCTR" loc="FIXTURE" />
          <ipd:req id="REQ-905" />
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="L3_P_SPON_PROCESS" name="FIXTURE - Sponsor" isExecutable="false">
    <bpmn:laneSet id="L3_P_SPON_LANESET">
