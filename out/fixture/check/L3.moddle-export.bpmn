        <bpmn:flowNodeRef>L3_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L3_E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="L3_S1" name="FIXTURE - Deviation report received">
      <bpmn:outgoing>L3_F1</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:callActivity id="L3_A1" name="FIXTURE - Classify protocol deviations" calledElement="L4_01_P_SPON_PROCESS">
      <bpmn:documentation>Sources: E6R3 FIXTURE
Requirements: REQ-901
Binding: binding-ICH
Jurisdiction: ICH</bpmn:documentation>
