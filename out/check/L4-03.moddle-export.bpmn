        <bpmn:flowNodeRef>L4_03_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_03_E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="L4_03_S1" name="Intentional protocol deviation communicated">
      <bpmn:outgoing>L4_03_F1</bpmn:outgoing>
