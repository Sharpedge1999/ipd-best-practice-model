Draft: DRAFT guidance
Verify: [verify] basis is draft guidance only - shown as DRAFT, never a binding step</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" deadline="promptly (REQ-080); per SIII.B routes (sponsor timeframe; IRB when identified for important deviations) (REQ-087)" draft="true" record="deviation report" party="investigator">
          <ipd:source key="E6R3" loc="A1-2.5.4" page="printed 13 / PDF 21" />
          <ipd:source key="FDA-PD24" loc="SIII.C" page="printed 10; lines 365-372; printed 10; lines 360-363" />
