          <ipd:source key="FDA-PD24" loc="SII" page="printed 2; line 60 (restated in SIII.A.1, printed 4)" />
          <ipd:source key="TCB-PD-TIRS" loc="SDefine" page="journal pp. 733-742 (section page not confirmed; PMC HTML read); journal pp. 733-742 (Fig. 2; section page not confirmed)" />
          <ipd:source key="TCB-PD-TIRS" loc="SPrepare" page="journal pp. 733-742 (Fig. 5; section page not confirmed)" />
