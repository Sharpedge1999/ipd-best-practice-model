          <ipd:source key="E6R3" loc="P3.1" page="printed 4 / PDF 12" />
          <ipd:source key="E6R3" loc="A1-3.9.2" page="printed 26 / PDF 34" />
          <ipd:source key="E6R3" loc="P10.1" page="printed 7 / PDF 15" />
          <ipd:source key="E6R3" loc="P10.3" page="printed 7 / PDF 15" />
          <ipd:source key="E6R3" loc="A1-3.9.5" page="printed 27 / PDF 35" />
