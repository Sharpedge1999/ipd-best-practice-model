    </bpmn:messageFlow>
    <bpmn:messageFlow id="L4_04_M3" name="Reclassification notified" sourceRef="L4_04_A6" targetRef="L4_04_P_INV">
      <bpmn:documentation>Sources: FDA-PD24 SIII.B.2 (p. printed 8; lines 262-265)
Requirements: REQ-100
Binding: guidance
Jurisdiction: US
Party: Sponsors
Draft: DRAFT guidance
Verify: [verify] basis is draft guidance only - shown as DRAFT, never a binding step</bpmn:documentation>
