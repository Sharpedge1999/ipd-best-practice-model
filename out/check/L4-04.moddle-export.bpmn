          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="L4_04_P_SPON_PROCESS" name="Sponsor" isExecutable="false">
    <bpmn:documentation>C-01 decision 1 of 4: G2 'Important protocol deviation?' (REQ-094). Decisions 2-4 are in L4-05.
C-18: a non-deviation leaves through E2 to GCP noncompliance handling; it is still assessed in L4-05, which runs from the same trigger.
Interface 'Service provider reporting' (REQ-213): service providers are not pools (D1); their reports enter through start event S1, which carries REQ-213.</bpmn:documentation>
    <bpmn:laneSet id="L4_04_P_SPON_LANESET">
      <bpmn:lane id="L4_04_L_SPON" name="Sponsor">
        <bpmn:documentation>Sources: E6R3 GL:Sponsor (p. printed 90 / PDF 98); EUCTR Art. 2(2)(14) (p. OJ L 158/12); 21CFR312 21CFR312.50 (p. n/a - eCFR web text without pagination)</bpmn:documentation>
        <bpmn:extensionElements>
          <ipd:trace>
            <ipd:source key="E6R3" loc="GL:Sponsor" page="printed 90 / PDF 98" />
            <ipd:source key="EUCTR" loc="Art. 2(2)(14)" page="OJ L 158/12" />
            <ipd:source key="21CFR312" loc="21CFR312.50" page="n/a - eCFR web text without pagination" />
          </ipd:trace>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>L4_04_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_04_E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="L4_04_S1" name="Potential protocol deviation identified">
      <bpmn:documentation>Sources: E6R3 A1-3.6.6 (p. printed 25 / PDF 33); EMA-SB SGlossary (p. printed 3/21); EMA-SB S6.2 (p. printed 9/21); EMA-SB S6.3 (p. printed 9/21)
Requirements: REQ-213
Binding: binding-ICH
Jurisdiction: ICH, EU
Party: service provider; Delegated party</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH EU" party="service provider; Delegated party">
          <ipd:source key="E6R3" loc="A1-3.6.6" page="printed 25 / PDF 33" />
          <ipd:source key="EMA-SB" loc="SGlossary" page="printed 3/21" />
          <ipd:source key="EMA-SB" loc="S6.2" page="printed 9/21" />
          <ipd:source key="EMA-SB" loc="S6.3" page="printed 9/21" />
          <ipd:req id="REQ-213" />
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:outgoing>L4_04_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="L4_04_A1" name="Confirm event is a protocol deviation">
      <bpmn:documentation>Sources: E3QA S3 (p. printed 6); FDA-PD24 SII (p. printed 1-2; lines 17-19 and 57-63; printed 2-3; lines 76-86); FDA-PD24 SIII.B.2 (p. printed 7; line 233); FDA-PD24 SIII.A (p. printed 3; lines 93-101); TCB-PD-TIRS SDefine (p. journal pp. 733-742 (section page not confirmed; PMC HTML read)); TCB-PD-TIRS SGCP-Compliance (p. journal pp. 733-742 (section page not confirmed; PMC HTML read))
Requirements: REQ-088, REQ-089
Binding: binding-ICH
Jurisdiction: ICH, US
Party: Sponsors; site staff, study staff, site or central monitoring, audits, regulatory inspections
Draft: DRAFT guidance
Verify: [verify binding] EU/US adoption of E3QA not checked by the research stems (C-06); [verify] the Q&amp;A item is unnumbered under heading '3. TERMINOLOGY'; fetch tool rendered its row label as '7 June 2012', which may be a row number 7 plus 'June 2012' (R2-066); [verify] basis is draft guidance only - shown as DRAFT, never a binding step</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" draft="true" party="Sponsors; site staff, study staff, site or central monitoring, audits, regulatory inspections">
          <ipd:source key="E3QA" loc="S3" page="printed 6" />
          <ipd:source key="FDA-PD24" loc="SII" page="printed 1-2; lines 17-19 and 57-63; printed 2-3; lines 76-86" />
          <ipd:source key="FDA-PD24" loc="SIII.B.2" page="printed 7; line 233" />
          <ipd:source key="FDA-PD24" loc="SIII.A" page="printed 3; lines 93-101" />
          <ipd:source key="TCB-PD-TIRS" loc="SDefine" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)" />
          <ipd:source key="TCB-PD-TIRS" loc="SGCP-Compliance" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)" />
          <ipd:req id="REQ-088" />
          <ipd:req id="REQ-089" />
          <ipd:verify>[verify binding] EU/US adoption of E3QA not checked by the research stems (C-06)</ipd:verify>
          <ipd:verify>[verify] the Q&amp;A item is unnumbered under heading '3. TERMINOLOGY'; fetch tool rendered its row label as '7 June 2012', which may be a row number 7 plus 'June 2012' (R2-066)</ipd:verify>
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_04_F1</bpmn:incoming>
      <bpmn:outgoing>L4_04_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="L4_04_G1" name="Protocol deviation?" gatewayDirection="Diverging">
      <bpmn:incoming>L4_04_F2</bpmn:incoming>
      <bpmn:outgoing>L4_04_F3</bpmn:outgoing>
      <bpmn:outgoing>L4_04_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="L4_04_E2" name="Issue handled outside the deviation process">
      <bpmn:incoming>L4_04_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="L4_04_A2" name="Record deviation information">
      <bpmn:documentation>Sources: EUCTR Art. 56(1) (p. OJ L 158/41); EMA-SB S5.1 (p. printed 8/21); TCB-PD-TIRS SStore (p. journal pp. 733-742 (section page not confirmed; PMC HTML read))
Requirements: REQ-090, REQ-091, REQ-092
Binding: binding-law
Jurisdiction: ICH, EU
Record: clinical trial information (deviation records); case report form or clinical trial master file; validated deviation repository
Party: the sponsor or the investigator, as applicable
Verify: [verify] Art. 56(1) applies to 'the sponsor or the investigator, as applicable'; applies equally in the Investigator/institution pool; [verify] documenting party not named in the text (R3-065)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="ICH EU" record="clinical trial information (deviation records); case report form or clinical trial master file; validated deviation repository" party="the sponsor or the investigator, as applicable">
          <ipd:source key="EUCTR" loc="Art. 56(1)" page="OJ L 158/41" />
          <ipd:source key="EMA-SB" loc="S5.1" page="printed 8/21" />
          <ipd:source key="TCB-PD-TIRS" loc="SStore" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)" />
          <ipd:req id="REQ-090" />
          <ipd:req id="REQ-091" />
          <ipd:req id="REQ-092" />
          <ipd:verify>[verify] Art. 56(1) applies to 'the sponsor or the investigator, as applicable'; applies equally in the Investigator/institution pool</ipd:verify>
          <ipd:verify>[verify] documenting party not named in the text (R3-065)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_04_F3</bpmn:incoming>
      <bpmn:outgoing>L4_04_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L4_04_A3" name="Classify deviation importance">
      <bpmn:documentation>Sources: E6R3 A1-3.9.3 (p. printed 27 / PDF 35); E3QA S3 (p. printed 6); FDA-PD24 SII (p. printed 2; line 60 (restated in SIII.A.1, printed 4)); TCB-PD-TIRS SDefine (p. journal pp. 733-742 (section page not confirmed; PMC HTML read); journal pp. 733-742 (Fig. 2; section page not confirmed)); TCB-PD-TIRS SPrepare (p. journal pp. 733-742 (Fig. 5; section page not confirmed)); TCB-PD-TIRS SClassify-and-Categorize (p. journal pp. 733-742 (section page not confirmed; PMC HTML read))
Requirements: REQ-094, REQ-095
Binding: binding-ICH
Jurisdiction: ICH, US
Deadline: upon identification
Record: deviation record (classification); deviation record (classification, category)
Party: the identifier
Verify: [verify binding] EU/US adoption of E3QA not checked by the research stems (C-06); [verify] single detailed fetch; wording 'reasonable to consider' not confirmed verbatim (R5-003); [verify] Decision Tree image (TransCelerate asset, robots-blocked) not read; branch logic unknown (R5-005); [verify] Fig. 5 content not readable (R5-016); [verify] 'the identifier' may sit in the Sponsor or the Investigator/institution pool; source does not say</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" deadline="upon identification" record="deviation record (classification); deviation record (classification, category)" party="the identifier">
          <ipd:source key="E6R3" loc="A1-3.9.3" page="printed 27 / PDF 35" />
          <ipd:source key="E3QA" loc="S3" page="printed 6" />
          <ipd:source key="FDA-PD24" loc="SII" page="printed 2; line 60 (restated in SIII.A.1, printed 4)" />
          <ipd:source key="TCB-PD-TIRS" loc="SDefine" page="journal pp. 733-742 (section page not confirmed; PMC HTML read); journal pp. 733-742 (Fig. 2; section page not confirmed)" />
          <ipd:source key="TCB-PD-TIRS" loc="SPrepare" page="journal pp. 733-742 (Fig. 5; section page not confirmed)" />
          <ipd:source key="TCB-PD-TIRS" loc="SClassify-and-Categorize" page="journal pp. 733-742 (section page not confirmed; PMC HTML read)" />
          <ipd:req id="REQ-094" />
          <ipd:req id="REQ-095" />
          <ipd:verify>[verify binding] EU/US adoption of E3QA not checked by the research stems (C-06)</ipd:verify>
          <ipd:verify>[verify] single detailed fetch; wording 'reasonable to consider' not confirmed verbatim (R5-003)</ipd:verify>
          <ipd:verify>[verify] Decision Tree image (TransCelerate asset, robots-blocked) not read; branch logic unknown (R5-005)</ipd:verify>
          <ipd:verify>[verify] Fig. 5 content not readable (R5-016)</ipd:verify>
          <ipd:verify>[verify] 'the identifier' may sit in the Sponsor or the Investigator/institution pool; source does not say</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_04_F5</bpmn:incoming>
      <bpmn:outgoing>L4_04_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="L4_04_G2" name="Important protocol deviation?" gatewayDirection="Diverging">
      <bpmn:documentation>Sources: E6R3 A1-3.9.3 (p. printed 27 / PDF 35); E3QA S3 (p. printed 6); FDA-PD24 SII (p. printed 2; line 60 (restated in SIII.A.1, printed 4)); TCB-PD-TIRS SDefine (p. journal pp. 733-742 (section page not confirmed; PMC HTML read); journal pp. 733-742 (Fig. 2; section page not confirmed)); TCB-PD-TIRS SPrepare (p. journal pp. 733-742 (Fig. 5; section page not confirmed))
Requirements: REQ-094
Binding: binding-ICH
Jurisdiction: ICH, US
Verify: [verify binding] EU/US adoption of E3QA not checked by the research stems (C-06); [verify] single detailed fetch; wording 'reasonable to consider' not confirmed verbatim (R5-003); [verify] Decision Tree image (TransCelerate asset, robots-blocked) not read; branch logic unknown (R5-005); [verify] Fig. 5 content not readable (R5-016)</bpmn:documentation>
