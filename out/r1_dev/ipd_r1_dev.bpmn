  <bpmn:process id="L4_02_P_SPON_PROCESS" name="Sponsor" isExecutable="false">
    <bpmn:documentation textFormat="text/plain">SCP-03: 16 activities (target 5-15) - user decision 06 Nov 2026 to merge identification channels; 26 nodes, within 31.
Sponsor-to-investigator flows M1 and M2 end on the Investigator/institution pool: a target node would form a cycle with the investigator's reports (layout constraint), and the investigator's review of communicated deviations is modelled in L4-04. Investigator reports enter the sponsor where they are reviewed: deviation report and premature unblinding explanation in centralised data review A1 (FDA-PD24 SIII.B.2: sponsors receive deviation information mainly through monitoring), system incident and suspected serious breach reports in the sponsor review A11, which takes the detection decision.
Legal monitoring duties (EU CTR Art. 48, 21 CFR 312.50/312.56(a)) sit on the timer start event because they cover both channels.</bpmn:documentation>
    <bpmn:laneSet id="L4_02_P_SPON_LANESET">
      <bpmn:lane id="L4_02_L_SPON" name="Sponsor">
        <bpmn:documentation textFormat="text/plain">Sources: E6R3 GL:Sponsor (p. printed 90 / PDF 98); EUCTR Art. 2(2)(14) (p. OJ L 158/12); 21CFR312 21CFR312.50 (p. n/a - eCFR web text without pagination)</bpmn:documentation>
        <bpmn:extensionElements>
          <ipd:trace>
            <ipd:source key="E6R3" loc="GL:Sponsor" page="printed 90 / PDF 98"/>
            <ipd:source key="EUCTR" loc="Art. 2(2)(14)" page="OJ L 158/12"/>
            <ipd:source key="21CFR312" loc="21CFR312.50" page="n/a - eCFR web text without pagination"/>
          </ipd:trace>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>L4_02_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_02_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_02_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_02_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_02_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_02_A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_02_A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>L4_02_G2</bpmn:flowNodeRef>
