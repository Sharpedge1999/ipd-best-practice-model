    <bpmn:messageFlow id="L3_M1" name="Protocol and deviation reporting instructions provided" sourceRef="L3_A1" targetRef="L3_P_INV">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-3.6.3(a) (p. printed 24 / PDF 32); FDA-PD24 SIII.B.2 (p. printed 7; lines 236-239); EMA-SB S3.2 (p. printed 5/21)
Requirements: REQ-032, REQ-026, REQ-027
Binding: binding-ICH
Jurisdiction: ICH, EU, US
Deadline: sponsor-defined (no FDA day count) (REQ-026); immediately (for the reporting party) (REQ-027)
Party: sponsor
Draft: DRAFT guidance
Verify: [verify] basis is draft guidance only - shown as DRAFT, never a binding step</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH EU US" deadline="sponsor-defined (no FDA day count) (REQ-026); immediately (for the reporting party) (REQ-027)" draft="true" party="sponsor">
          <ipd:source key="E6R3" loc="A1-3.6.3(a)" page="printed 24 / PDF 32"/>
          <ipd:source key="FDA-PD24" loc="SIII.B.2" page="printed 7; lines 236-239"/>
          <ipd:source key="EMA-SB" loc="S3.2" page="printed 5/21"/>
          <ipd:req id="REQ-032"/>
          <ipd:req id="REQ-026"/>
          <ipd:req id="REQ-027"/>
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M2" name="Detected deviation communicated" sourceRef="L3_A2" targetRef="L3_P_INV">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.5.3 (p. printed 13 / PDF 21); E6R3 A1-3.11.4.5.1(b) (p. printed 32 / PDF 40); FDA-RBM23 SQ8 (p. printed 10)
Requirements: REQ-047, REQ-053
Binding: binding-ICH
Jurisdiction: ICH, US
Party: sponsor
Verify: [verify] gerund item; Monitor lane inferred from A1-3.11.4.4 and A1-3.11.4.5.1(a) (R1 C7)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" party="sponsor">
          <ipd:source key="E6R3" loc="A1-2.5.3" page="printed 13 / PDF 21"/>
          <ipd:source key="E6R3" loc="A1-3.11.4.5.1(b)" page="printed 32 / PDF 40"/>
          <ipd:source key="FDA-RBM23" loc="SQ8" page="printed 10"/>
          <ipd:req id="REQ-047"/>
          <ipd:req id="REQ-053"/>
          <ipd:verify>[verify] gerund item; Monitor lane inferred from A1-3.11.4.4 and A1-3.11.4.5.1(a) (R1 C7)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M3" name="Protocol amendment submitted for immediate-hazard change" sourceRef="L3_A3" targetRef="L3_P_RA">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.30(b)(2)(ii) (p. n/a - eCFR web text without pagination)
Requirements: REQ-085
Binding: binding-law
Jurisdiction: US
Deadline: subsequently (no period stated)
Party: sponsor
Verify: [verify] Whether the 5-working-day window of 21CFR56.104(c) applies to IRB notification of immediate-hazard protocol changes, or only the manner of notification; regulation text gives the cross-reference only (R4-005)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="US" deadline="subsequently (no period stated)" party="sponsor">
          <ipd:source key="21CFR312" loc="21CFR312.30(b)(2)(ii)" page="n/a - eCFR web text without pagination"/>
          <ipd:req id="REQ-085"/>
          <ipd:verify>[verify] Whether the 5-working-day window of 21CFR56.104(c) applies to IRB notification of immediate-hazard protocol changes, or only the manner of notification; regulation text gives the cross-reference only (R4-005)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M4" name="Serious breach notified" sourceRef="L3_A5" targetRef="L3_P_RA">
      <bpmn:documentation textFormat="text/plain">Sources: EUCTR Art. 52(1) (p. OJ L 158/40); EMA-SB S3.2 (p. printed 5/21); EUCTR-QA S11.3 (p. printed 1-2 (chapter 11)); EMA-SB S3.1 (p. printed 5/21); EUCTR-QA S1.5 (p. printed 4-5 (chapter 1; page numbers restart per chapter)); CTIS-BT-SB24 SSlide-20 (p. slide 20; notification type label on an unnumbered CTCG slide)
Requirements: REQ-111
Binding: binding-law
Jurisdiction: EU
Deadline: without undue delay, at the latest 7 (calendar) days from sponsor awareness of the potential breach
Party: sponsor
Verify: [verify] whose awareness (delegated party, CRO, monitor) starts the clock is not defined (C-05); [verify] 'seven days' (Art. 52(1)) read as calendar days per EMA-SB S3.2 (C-13)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="EU" deadline="without undue delay, at the latest 7 (calendar) days from sponsor awareness of the potential breach" party="sponsor">
          <ipd:source key="EUCTR" loc="Art. 52(1)" page="OJ L 158/40"/>
          <ipd:source key="EMA-SB" loc="S3.2" page="printed 5/21"/>
          <ipd:source key="EUCTR-QA" loc="S11.3" page="printed 1-2 (chapter 11)"/>
          <ipd:source key="EMA-SB" loc="S3.1" page="printed 5/21"/>
          <ipd:source key="EUCTR-QA" loc="S1.5" page="printed 4-5 (chapter 1; page numbers restart per chapter)"/>
          <ipd:source key="CTIS-BT-SB24" loc="SSlide-20" page="slide 20; notification type label on an unnumbered CTCG slide"/>
          <ipd:req id="REQ-111"/>
          <ipd:verify>[verify] whose awareness (delegated party, CRO, monitor) starts the clock is not defined (C-05)</ipd:verify>
          <ipd:verify>[verify] 'seven days' (Art. 52(1)) read as calendar days per EMA-SB S3.2 (C-13)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M5" name="Serious noncompliance notified" sourceRef="L3_A5" targetRef="L3_P_RA">
