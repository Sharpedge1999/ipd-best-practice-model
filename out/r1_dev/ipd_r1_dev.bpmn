      </bpmn:extensionElements>
      <bpmn:incoming>L4_02_F22</bpmn:incoming>
      <bpmn:outgoing>L4_02_F25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L4_02_A16" name="Report suspected serious breach to sponsor">
      <bpmn:documentation textFormat="text/plain">Sources: EMA-SB S6.4 (p. printed 9-10/21)
Requirements: REQ-069
Binding: guidance
Jurisdiction: EU
Deadline: promptly
Record: site process / SOP
Party: Principal Investigator</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="guidance" jurisdiction="EU" deadline="promptly" record="site process / SOP" party="Principal Investigator">
          <ipd:source key="EMA-SB" loc="S6.4" page="printed 9-10/21"/>
          <ipd:req id="REQ-069"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>L4_02_GR_EU_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>L4_02_F23</bpmn:incoming>
      <bpmn:outgoing>L4_02_F26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="L4_02_G5" gatewayDirection="Converging">
      <bpmn:incoming>L4_02_F24</bpmn:incoming>
      <bpmn:incoming>L4_02_F25</bpmn:incoming>
      <bpmn:incoming>L4_02_F26</bpmn:incoming>
      <bpmn:outgoing>L4_02_F27</bpmn:outgoing>
    </bpmn:inclusiveGateway>
