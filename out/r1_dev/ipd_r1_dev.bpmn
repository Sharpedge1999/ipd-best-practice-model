    <bpmn:startEvent id="L4_02_S1" name="Monitoring activity scheduled">
      <bpmn:documentation textFormat="text/plain">Sources: EUCTR Art. 48 (p. OJ L 158/39); 21CFR312 21CFR312.50 (p. n/a - eCFR web text without pagination); 21CFR312 21CFR312.56(a) (p. n/a - eCFR web text without pagination)
