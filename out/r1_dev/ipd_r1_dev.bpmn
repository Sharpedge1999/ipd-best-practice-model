    <bpmn:task id="L4_02_A12" name="Communicate detected deviations to investigator">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.5.3 (p. printed 13 / PDF 21); E6R3 A1-3.11.4.5.1(b) (p. printed 32 / PDF 40); FDA-RBM23 SQ8 (p. printed 10)
Requirements: REQ-047, REQ-053
Binding: binding-ICH
Jurisdiction: ICH, US
Party: sponsor
Verify: [verify] gerund item; Monitor lane inferred from A1-3.11.4.4 and A1-3.11.4.5.1(a) (R1 C7)</bpmn:documentation>
      <bpmn:extensionElements>
