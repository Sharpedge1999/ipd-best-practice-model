    <bpmn:messageFlow id="L4_06_M3" name="Persistent serious noncompliance notified" sourceRef="L4_06_A9" targetRef="L4_06_P_RA">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-3.12.3 (p. printed 35 / PDF 43)
Requirements: REQ-146
Binding: binding-ICH
Jurisdiction: ICH
Deadline: promptly
Party: sponsor</bpmn:documentation>
