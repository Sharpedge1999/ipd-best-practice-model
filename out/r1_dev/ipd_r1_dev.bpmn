        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M7" name="Corrective action required" sourceRef="L3_A6" targetRef="L3_P_INV">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.56(b) (p. n/a - eCFR web text without pagination); E6R3 A1-3.12.1 (p. printed 35 / PDF 43)
Requirements: REQ-134, REQ-135
