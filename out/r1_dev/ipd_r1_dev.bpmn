        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L4_05_M7" name="Important protocol deviation submitted" sourceRef="L4_05_A10" targetRef="L4_05_P_IEC">
      <bpmn:documentation textFormat="text/plain">Sources: FDA-PD24 SIII.B.3 (p. printed 10; lines 351-353)
Requirements: REQ-122
Binding: guidance
Jurisdiction: US
Deadline: when identified, where possible
Party: the investigator
Draft: DRAFT guidance
Verify: [verify] basis is draft guidance only - shown as DRAFT, never a binding step</bpmn:documentation>
