      <bpmn:incoming>L4_03_F6</bpmn:incoming>
      <bpmn:incoming>L4_03_F32</bpmn:incoming>
      <bpmn:outgoing>L4_03_F33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="L4_03_G2" name="Which jurisdiction-specific actions apply?" gatewayDirection="Diverging" default="L4_03_F9">
      <bpmn:documentation textFormat="text/plain">Justification: A trial can run under EU CTR and an IND at the same time, so the EU urgent safety measure hand-off (C-08) and the FDA protocol amendment (21 CFR 312.30(b)(2)(ii)) can both apply; they are not exclusive alternatives (FLW-07, DEC-02). Default flow 'Neither' when no jurisdiction-specific action applies.</bpmn:documentation>
      <bpmn:incoming>L4_03_F33</bpmn:incoming>
      <bpmn:outgoing>L4_03_F7</bpmn:outgoing>
      <bpmn:outgoing>L4_03_F8</bpmn:outgoing>
      <bpmn:outgoing>L4_03_F9</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:callActivity id="L4_03_A4" name="Handle urgent safety measures">
      <bpmn:documentation textFormat="text/plain">Sources: EUCTR Art. 54(1) (p. OJ L 158/40); EUCTR Art. 54(2) (p. OJ L 158/40); EUCTR Art. 54(3) (p. OJ L 158/40); EUCTR-QA S10.9 (p. printed 8-9 (chapter 10); printed 9 (chapter 10)); EUCTR-QA S10.1 (p. printed 1-4 (chapter 10)); EUCTR-QA S7.27 (p. printed 22 (chapter 7); printed 23 (chapter 7))
Requirements: REQ-217, REQ-218, REQ-219, REQ-220
Binding: binding-law
Jurisdiction: EU
Deadline: without undue delay but no later than seven days from the date the measures have been taken
Record: urgent safety measure notification in CTIS
Party: sponsor; the investigator</bpmn:documentation>
