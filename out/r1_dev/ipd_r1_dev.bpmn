      <bpmn:incoming>L4_08_F14</bpmn:incoming>
      <bpmn:incoming>L4_08_F15</bpmn:incoming>
      <bpmn:incoming>L4_08_F16</bpmn:incoming>
      <bpmn:outgoing>L4_08_F17</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="L4_08_E2" name="Investigator records archived">
      <bpmn:incoming>L4_08_F17</bpmn:incoming>
    </bpmn:endEvent>
