<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ipd="urn:ipd-best-practice:trace:1.0" id="IPD_DEFINITIONS" targetNamespace="urn:ipd-best-practice:model" exporter="ipd spec2bpmn" exporterVersion="1.0">
  <bpmn:category id="L3_GR_CONDUCT_CATEGORY">
    <bpmn:categoryValue id="L3_GR_CONDUCT_VALUE" value="Runs repeatedly during trial conduct"/>
  </bpmn:category>
  <bpmn:collaboration id="L3_COLLAB" name="Important protocol deviation management - overview">
    <bpmn:documentation textFormat="text/plain">Model: L3
Title: Important protocol deviation management - overview</bpmn:documentation>
    <bpmn:participant id="L3_P_SPON" name="Sponsor" processRef="L3_P_SPON_PROCESS">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 GL:Sponsor (p. printed 90 / PDF 98); EUCTR Art. 47 (p. OJ L 158/39); 21CFR312 21CFR312.50 (p. n/a - eCFR web text without pagination); E6R3 P3.1 (p. printed 4 / PDF 12); E6R3 A1-3.9.2 (p. printed 26 / PDF 34); E6R3 P10.1 (p. printed 7 / PDF 15); E6R3 P10.3 (p. printed 7 / PDF 15); E6R3 A1-3.9.5 (p. printed 27 / PDF 35); E6R3 A2-3.8 (p. printed 62 / PDF 70); EMA-SB SGlossary (p. printed 3/21); TCB-RBQM SQTL-Process (p. journal pp. 251-261 (section page not confirmed))</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace>
          <ipd:source key="E6R3" loc="GL:Sponsor" page="printed 90 / PDF 98"/>
          <ipd:source key="EUCTR" loc="Art. 47" page="OJ L 158/39"/>
