  <bpmn:process id="L4_02_P_INV_PROCESS" name="Investigator/institution" isExecutable="false">
    <bpmn:startEvent id="L4_02_S2" name="Protocol deviation identified at site">
      <bpmn:outgoing>L4_02_F19</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="L4_02_A13" name="Document protocol deviation">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.62(b) (p. n/a - eCFR web text without pagination); E6R3 A1-2.5.3 (p. printed 13 / PDF 21); E6R3 A1-2.12.2 (p. printed 21 / PDF 29); E6R3 A1-2.12.6 (p. printed 22 / PDF 30); E6R3 A1-2.12.3 (p. printed 21 / PDF 29)
Requirements: REQ-062, REQ-063, REQ-064, REQ-065
Binding: binding-law
Jurisdiction: ICH, US
Deadline: timely
Record: protocol deviation documentation (site records); source records; reported data with audit trail; case histories (CRFs, consent forms, medical records)
Party: investigator
Verify: [verify] 21 CFR 312.62(b) does not name deviations; applied as the US record basis for site documentation</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="ICH US" deadline="timely" record="protocol deviation documentation (site records); source records; reported data with audit trail; case histories (CRFs, consent forms, medical records)" party="investigator">
          <ipd:source key="21CFR312" loc="21CFR312.62(b)" page="n/a - eCFR web text without pagination"/>
          <ipd:source key="E6R3" loc="A1-2.5.3" page="printed 13 / PDF 21"/>
          <ipd:source key="E6R3" loc="A1-2.12.2" page="printed 21 / PDF 29"/>
          <ipd:source key="E6R3" loc="A1-2.12.6" page="printed 22 / PDF 30"/>
          <ipd:source key="E6R3" loc="A1-2.12.3" page="printed 21 / PDF 29"/>
          <ipd:req id="REQ-062"/>
          <ipd:req id="REQ-063"/>
          <ipd:req id="REQ-064"/>
          <ipd:req id="REQ-065"/>
          <ipd:verify>[verify] 21 CFR 312.62(b) does not name deviations; applied as the US record basis for site documentation</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_02_F19</bpmn:incoming>
      <bpmn:outgoing>L4_02_F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="L4_02_G4" name="Which reports are due?" gatewayDirection="Diverging" default="L4_02_F21">
      <bpmn:documentation textFormat="text/plain">Justification: One deviation can require one or more reports with separate sources: the deviation report (FDA-PD24 SIII.B.1, DRAFT) including the premature unblinding explanation (E6R3 A1-2.11), the computerised system incident report (E6R3 A1-2.12.10(e)) and, in the EU, the suspected serious breach report (EMA-SB S6.4) (FLW-07, DEC-02). The deviation report is the default flow.</bpmn:documentation>
      <bpmn:incoming>L4_02_F20</bpmn:incoming>
      <bpmn:outgoing>L4_02_F21</bpmn:outgoing>
      <bpmn:outgoing>L4_02_F22</bpmn:outgoing>
      <bpmn:outgoing>L4_02_F23</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="L4_02_A14" name="Report deviation to sponsor">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.11 (p. printed 21 / PDF 29); FDA-PD24 SIII.B.1 (p. printed 6; lines 194-198)
Requirements: REQ-066, REQ-067
Binding: binding-ICH
Jurisdiction: ICH, US
Deadline: per sponsor-specified timeframe (REQ-066); promptly (REQ-067)
Record: deviation report; documentation and explanation of premature unblinding
Party: investigator
Draft: DRAFT guidance
Verify: [verify] basis is draft guidance only - shown as DRAFT, never a binding step; [verify] E6(R3) does not label premature unblinding a protocol deviation; trial-specific criteria decide (R1 C13)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" deadline="per sponsor-specified timeframe (REQ-066); promptly (REQ-067)" draft="true" record="deviation report; documentation and explanation of premature unblinding" party="investigator">
          <ipd:source key="E6R3" loc="A1-2.11" page="printed 21 / PDF 29"/>
          <ipd:source key="FDA-PD24" loc="SIII.B.1" page="printed 6; lines 194-198"/>
          <ipd:req id="REQ-066"/>
          <ipd:req id="REQ-067"/>
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
          <ipd:verify>[verify] E6(R3) does not label premature unblinding a protocol deviation; trial-specific criteria decide (R1 C13)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_02_F21</bpmn:incoming>
      <bpmn:outgoing>L4_02_F24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="L4_02_A15" name="Report computerised system incident">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.12.10(e) (p. printed 22 / PDF 30)
Requirements: REQ-068
Binding: binding-ICH
Jurisdiction: ICH
Party: investigator/institution</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" party="investigator/institution">
          <ipd:source key="E6R3" loc="A1-2.12.10(e)" page="printed 22 / PDF 30"/>
