    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M6" name="Serious noncompliance notified" sourceRef="L3_A5" targetRef="L3_P_IEC">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-3.12.2 (p. printed 35 / PDF 43)
Requirements: REQ-119
Binding: binding-ICH
Jurisdiction: ICH
Party: sponsor</bpmn:documentation>
