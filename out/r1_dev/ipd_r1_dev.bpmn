  <bpmn:process id="L4_04_P_SPON_PROCESS" name="Sponsor" isExecutable="false">
    <bpmn:documentation textFormat="text/plain">C-01 decision 1 of 4: G2 'Important protocol deviation?' (REQ-094). Decisions 2-4 are in L4-05.
