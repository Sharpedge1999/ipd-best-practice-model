    <bpmn:messageFlow id="L4_05_M5" name="Change significantly affecting conduct reported" sourceRef="L4_05_A8" targetRef="L4_05_P_IEC">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.4.6 (p. printed 13 / PDF 21); E6R3 A1-1.4.8(b) (p. printed 11 / PDF 19)
Requirements: REQ-120
Binding: binding-ICH
Jurisdiction: ICH
Deadline: promptly
Party: investigator or sponsor; investigator/institution
Verify: [verify] E6(R3) does not state whether a protocol deviation counts as such a 'change' (C-03); [verify] duty may lie with investigator or sponsor (A1-2.4.6)</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="promptly" party="investigator or sponsor; investigator/institution">
