    <bpmn:messageFlow id="L3_M9" name="Clinical study report provided" sourceRef="L3_A7" targetRef="L3_P_RA">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-3.17.2(a) (p. printed 44 / PDF 52); E3QA S1 (p. printed 1-2); FDA-PD24 SIII.B.2 (p. printed 7; lines 241-243, footnote 16; printed 7; lines 243-245, footnote 17)
Requirements: REQ-184, REQ-169
Binding: binding-ICH
Jurisdiction: ICH, US
Deadline: with the marketing application
Party: sponsor
Draft: DRAFT guidance
Verify: [verify binding] EU/US adoption of E3QA not checked by the research stems (C-06); [verify] answer content from a single fetch (F33); topic confirmed in F16 (R2-065); [verify] Exact wording and modal of footnote 16 (BIMO Technical Conformance Guide reference) not double-checked (R4-055); [verify] basis is draft guidance only - shown as DRAFT, never a binding step</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" deadline="with the marketing application" draft="true" party="sponsor">
          <ipd:source key="E6R3" loc="A1-3.17.2(a)" page="printed 44 / PDF 52"/>
          <ipd:source key="E3QA" loc="S1" page="printed 1-2"/>
          <ipd:source key="FDA-PD24" loc="SIII.B.2" page="printed 7; lines 241-243, footnote 16; printed 7; lines 243-245, footnote 17"/>
          <ipd:req id="REQ-184"/>
          <ipd:req id="REQ-169"/>
          <ipd:verify>[verify binding] EU/US adoption of E3QA not checked by the research stems (C-06)</ipd:verify>
          <ipd:verify>[verify] answer content from a single fetch (F33); topic confirmed in F16 (R2-065)</ipd:verify>
          <ipd:verify>[verify] Exact wording and modal of footnote 16 (BIMO Technical Conformance Guide reference) not double-checked (R4-055)</ipd:verify>
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L3_M10" name="Records no longer needed notified" sourceRef="L3_A8" targetRef="L3_P_INV">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.12.11 (p. printed 22 / PDF 30); E6R3 A1-2.12.12 (p. printed 23 / PDF 31); E6R3 AppC-C.1.3 (p. printed 75 / PDF 83)
Requirements: REQ-191
Binding: binding-ICH
Jurisdiction: ICH
Deadline: longest of the required period or sponsor notice
Party: investigator/institution</bpmn:documentation>
      <bpmn:extensionElements>
