    <bpmn:messageFlow id="L4_04_M1" name="Deviation review requested" sourceRef="L4_04_A4" targetRef="L4_04_S2">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.5.3 (p. printed 13 / PDF 21)
Requirements: REQ-093
Binding: binding-ICH
Jurisdiction: ICH
