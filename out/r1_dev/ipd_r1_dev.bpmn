          <ipd:source key="21CFR312" loc="21CFR312.30(b)(2)(ii)" page="n/a - eCFR web text without pagination"/>
          <ipd:source key="21CFR56" loc="21CFR56.104(c)" page="n/a - web text without pagination"/>
          <ipd:source key="E6R3" loc="A1-1.4.8(a)" page="printed 10-11 / PDF 18-19"/>
          <ipd:source key="E6R3" loc="A1-2.5.5" page="printed 13 / PDF 21"/>
          <ipd:req id="REQ-081"/>
          <ipd:req id="REQ-086"/>
          <ipd:verify>[verify] notifying party not named (passive voice); Investigator chosen because 21 CFR 312.66 places IRB reporting on the investigator</ipd:verify>
          <ipd:verify>[verify] Whether the 5-working-day window of 21CFR56.104(c) applies to IRB notification of immediate-hazard protocol changes, or only the manner of notification; regulation text gives the cross-reference only (R4-005)</ipd:verify>
          <ipd:verify>[verify] eCFR text of 56.104(c) not retrievable (robots); confirm against eCFR or govinfo before X1 (R4-030)</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L4_03_M3" name="Intentional deviation request submitted" sourceRef="L4_03_A12" targetRef="L4_03_S1">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.53(c)(1)(vi)(a) (p. n/a - eCFR web text without pagination); FDA-PD24 SIII.B.1 (p. printed 6; lines 199-203; repeated SIII.B.2 lines 268-271)
