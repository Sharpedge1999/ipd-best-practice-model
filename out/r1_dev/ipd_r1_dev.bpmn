        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" deadline="timely (REQ-036); early (REQ-041)" draft="true" record="centralised monitoring report; deviation listings; oversight / monitoring plan" party="sponsor; CRAs; site monitors and centralized monitoring">
