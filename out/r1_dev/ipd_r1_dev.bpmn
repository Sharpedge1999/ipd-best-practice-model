          <ipd:source key="21CFR312" loc="21CFR312.50" page="n/a - eCFR web text without pagination"/>
          <ipd:source key="21CFR312" loc="21CFR312.56(a)" page="n/a - eCFR web text without pagination"/>
          <ipd:req id="REQ-048"/>
          <ipd:req id="REQ-049"/>
