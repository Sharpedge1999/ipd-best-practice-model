    <bpmn:task id="L4_01_A3" name="Define risk controls for CtQ risks">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-3.10.1.3 (p. printed 28 / PDF 36); E8R1 S3.2 (p. printed 4; printed 4-5); E6R3 A1-3.10.1.4 (p. printed 28 / PDF 36); E6R3 P6.3 (p. printed 5 / PDF 13); E6R3 A1-3.16.1(x)(ix) (p. printed 42-43 / PDF 50-51); FDA-PD24 SIII.B.2 (p. printed 9; lines 305-310, footnotes 22-23); FDA-RBM23 SQ1 (p. printed 4)
Requirements: REQ-005, REQ-007, REQ-008, REQ-009, REQ-030
Binding: binding-ICH
Jurisdiction: ICH, US
Record: risk control measures; study-specific plans; risk documentation
Party: sponsor; The sponsor and other parties designing quality into a clinical study
Verify: [verify binding] EU/US adoption of E8R1 not checked by the research stems (C-06); [verify] sentence content from a single fetch (F02) (R2-010); [verify] principle without named party; Sponsor lane assigned by context</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH US" record="risk control measures; study-specific plans; risk documentation" party="sponsor; The sponsor and other parties designing quality into a clinical study">
          <ipd:source key="E6R3" loc="A1-3.10.1.3" page="printed 28 / PDF 36"/>
          <ipd:source key="E8R1" loc="S3.2" page="printed 4; printed 4-5"/>
          <ipd:source key="E6R3" loc="A1-3.10.1.4" page="printed 28 / PDF 36"/>
          <ipd:source key="E6R3" loc="P6.3" page="printed 5 / PDF 13"/>
          <ipd:source key="E6R3" loc="A1-3.16.1(x)(ix)" page="printed 42-43 / PDF 50-51"/>
          <ipd:source key="FDA-PD24" loc="SIII.B.2" page="printed 9; lines 305-310, footnotes 22-23"/>
          <ipd:source key="FDA-RBM23" loc="SQ1" page="printed 4"/>
          <ipd:req id="REQ-005"/>
          <ipd:req id="REQ-007"/>
          <ipd:req id="REQ-008"/>
          <ipd:req id="REQ-009"/>
