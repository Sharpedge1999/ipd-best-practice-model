    </bpmn:task>
    <bpmn:task id="L4_08_A2" name="Retain related essential records">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 AppC-C.3.2 (p. printed 81 / PDF 89; printed 79 / PDF 87); E6R3 AppC-C.3.1(a) (p. printed 77 / PDF 85); E6R3 AppC-C.3.1(s) (p. printed 78 / PDF 86); E6R3 A1-3.16.3(a) (p. printed 43 / PDF 51); E6R3 P9.5 (p. printed 6 / PDF 14); E6R3 A1-4.2.7 (p. printed 48 / PDF 56)
Requirements: REQ-189, REQ-190, REQ-193
Binding: binding-ICH
Jurisdiction: ICH
Deadline: retention period per applicable regulatory requirements (REQ-189); per applicable regulatory requirements (REQ-190); throughout the retention period (REQ-193)
Record: essential records (Appendix C); sponsor-specific essential records; archived data and metadata
Party: sponsor; sponsor and investigator/institution; sponsors and investigators; responsible party</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="retention period per applicable regulatory requirements (REQ-189); per applicable regulatory requirements (REQ-190); throughout the retention period (REQ-193)" record="essential records (Appendix C); sponsor-specific essential records; archived data and metadata" party="sponsor; sponsor and investigator/institution; sponsors and investigators; responsible party">
          <ipd:source key="E6R3" loc="AppC-C.3.2" page="printed 81 / PDF 89; printed 79 / PDF 87"/>
          <ipd:source key="E6R3" loc="AppC-C.3.1(a)" page="printed 77 / PDF 85"/>
          <ipd:source key="E6R3" loc="AppC-C.3.1(s)" page="printed 78 / PDF 86"/>
          <ipd:source key="E6R3" loc="A1-3.16.3(a)" page="printed 43 / PDF 51"/>
          <ipd:source key="E6R3" loc="P9.5" page="printed 6 / PDF 14"/>
          <ipd:source key="E6R3" loc="A1-4.2.7" page="printed 48 / PDF 56"/>
          <ipd:req id="REQ-189"/>
          <ipd:req id="REQ-190"/>
          <ipd:req id="REQ-193"/>
        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_08_F2</bpmn:incoming>
      <bpmn:outgoing>L4_08_F3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="L4_08_D1_A2_OUT">
        <bpmn:targetRef>L4_08_D1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="L4_08_A3" name="Keep records accessible">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 AppC-C.2.6 (p. printed 76 / PDF 84)
Requirements: REQ-192
Binding: binding-ICH
Jurisdiction: ICH
Record: essential records
Party: sponsor and investigator/institution</bpmn:documentation>
