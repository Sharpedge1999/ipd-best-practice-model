          <ipd:req id="REQ-026" />
          <ipd:req id="REQ-027" />
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L4_01_M2" name="Agreement to comply signed" sourceRef="L4_01_A16" targetRef="L4_01_A14">
      <bpmn:documentation>Sources: E6R3 A1-3.6.3(a) (p. printed 24 / PDF 32)
Requirements: REQ-032
Binding: binding-ICH
Jurisdiction: ICH
Party: investigator/institution</bpmn:documentation>
