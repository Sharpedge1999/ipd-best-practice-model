          <ipd:req id="REQ-169"/>
          <ipd:verify>[verify binding] EU/US adoption of E3QA not checked by the research stems (C-06)</ipd:verify>
          <ipd:verify>[verify] answer content from a single fetch (F33); topic confirmed in F16 (R2-065)</ipd:verify>
          <ipd:verify>[verify] Exact wording and modal of footnote 16 (BIMO Technical Conformance Guide reference) not double-checked (R4-055)</ipd:verify>
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="L4_07_M2" name="DV dataset submitted" sourceRef="L4_07_A12" targetRef="L4_07_P_RA">
      <bpmn:documentation textFormat="text/plain">Sources: FDA-SDTCG S4.1.1.3 (p. 16 or 17 of 97 [verify]); FDA-PD24 SIII.B.2 (p. printed 7; lines 246-248, footnote 18); NCIT-DV SC49585 (p. web page)
Requirements: REQ-185
Binding: guidance
Jurisdiction: ICH, US
Deadline: with the study data submission
Party: Sponsors
Verify: [verify] page number: fetches gave 16 and 17 of 97 (R5-069); [verify] secondary mirror of NCIt; SDTMIG v3.4 DV text (purpose, assumptions) behind CDISC login, not read (R5-068)</bpmn:documentation>
