          <ipd:req id="REQ-161"/>
          <ipd:req id="REQ-165"/>
          <ipd:verify>[verify binding] EU/US adoption of E9 not checked by the research stems (C-06)</ipd:verify>
          <ipd:verify>[verify binding] EU/US adoption of E9R1 not checked by the research stems (C-06)</ipd:verify>
