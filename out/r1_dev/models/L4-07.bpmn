      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="L4_07_S1" name="Data finalisation initiated">
      <bpmn:outgoing>L4_07_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="L4_07_A1" name="Compile and finalise deviations">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-4.2.6(b) (p. printed 48 / PDF 56); TCB-PD STaking-a-holistic-approach-CLOSEOUT [verify] (p. web page (carousel tab inferred)); TCB-PD-TIRS SClose-Out (p. journal pp. 733-742 (section page not confirmed; PMC HTML read))
Requirements: REQ-154, REQ-155
Binding: binding-ICH
Jurisdiction: ICH
Deadline: before interim or final analysis; best practice: after the last study data have been reviewed
Record: final deviation list; closed-out PDAP; data finalisation documentation
Party: responsible party; Each company</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-ICH" jurisdiction="ICH" deadline="before interim or final analysis; best practice: after the last study data have been reviewed" record="final deviation list; closed-out PDAP; data finalisation documentation" party="responsible party; Each company">
