        </ipd:trace>
      </bpmn:extensionElements>
      <bpmn:incoming>L4_07_F4</bpmn:incoming>
      <bpmn:outgoing>L4_07_F5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="L4_07_A5" name="Characterise impact of each iPD">
      <bpmn:documentation textFormat="text/plain">Sources: E9 S5.2 (p. printed 22); E9 S7.1 (p. printed 30); E9R1 SA.1 (p. printed 3); E9R1 SA.5.3 (p. printed 18); TCB-PD STaking-a-holistic-approach-REVIEW-ANALYZE [verify] (p. web page (carousel tab inferred))
