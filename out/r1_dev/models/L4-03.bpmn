        <ipd:trace binding="binding-law" jurisdiction="US" deadline="before the change (safety exception) (REQ-073); before the departure (REQ-074)" draft="true" party="investigator">
          <ipd:source key="21CFR312" loc="21CFR312.53(c)(1)(vi)(a)" page="n/a - eCFR web text without pagination"/>
          <ipd:source key="FDA-PD24" loc="SIII.B.1" page="printed 6; lines 199-203; repeated SIII.B.2 lines 268-271"/>
          <ipd:req id="REQ-073"/>
          <ipd:req id="REQ-074"/>
          <ipd:verify>[verify] basis is draft guidance only - shown as DRAFT, never a binding step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
    </bpmn:messageFlow>
