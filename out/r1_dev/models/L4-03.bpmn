    <bpmn:messageFlow id="L4_03_M6" name="Approval of intentional deviation requested" sourceRef="L4_03_A12" targetRef="L4_03_P_IEC">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.66 (p. n/a - eCFR web text without pagination); 21CFR312 21CFR312.53(c)(1)(vii) (p. n/a - eCFR web text without pagination); E6R3 A1-1.4.7 (p. printed 10 / PDF 18)
