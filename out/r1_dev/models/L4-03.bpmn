    <bpmn:messageFlow id="L4_03_M1" name="Immediate-hazard deviation reported" sourceRef="L4_03_A10" targetRef="L4_03_S1">
      <bpmn:documentation textFormat="text/plain">Sources: E6R3 A1-2.5.4 (p. printed 13 / PDF 21)
Requirements: REQ-080
Binding: binding-ICH
Jurisdiction: ICH
Deadline: promptly
Party: investigator</bpmn:documentation>
