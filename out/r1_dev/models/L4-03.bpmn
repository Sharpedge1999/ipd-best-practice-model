    <bpmn:task id="L4_03_A8" name="Assess immediate hazard to participants">
      <bpmn:documentation textFormat="text/plain">Sources: 21CFR312 21CFR312.66 (p. n/a - eCFR web text without pagination); 21CFR312 21CFR312.53(c)(1)(vii) (p. n/a - eCFR web text without pagination); E6R3 A1-2.5.4 (p. printed 13 / PDF 21); E6R3 A1-1.4.7 (p. printed 10 / PDF 18)
Requirements: REQ-078, REQ-070, REQ-071
Binding: binding-law
Jurisdiction: ICH, US
Deadline: before implementation (REQ-070); before the change (immediate-hazard exception) (REQ-071)
Record: IRB approval
Party: investigator; IRB/IEC
Verify: [verify] E6(R3) A1-1.4.7 frames this as an IRB/IEC written procedure; the party initiating the change is not named; [verify] assessment step implied by the immediate-hazard exception in E6R3 A1-2.5.4, A1-1.4.7 and 21 CFR 312.66; no source names it as a separate step</bpmn:documentation>
      <bpmn:extensionElements>
        <ipd:trace binding="binding-law" jurisdiction="ICH US" deadline="before implementation (REQ-070); before the change (immediate-hazard exception) (REQ-071)" record="IRB approval" party="investigator; IRB/IEC">
          <ipd:source key="21CFR312" loc="21CFR312.66" page="n/a - eCFR web text without pagination"/>
          <ipd:source key="21CFR312" loc="21CFR312.53(c)(1)(vii)" page="n/a - eCFR web text without pagination"/>
          <ipd:source key="E6R3" loc="A1-2.5.4" page="printed 13 / PDF 21"/>
          <ipd:source key="E6R3" loc="A1-1.4.7" page="printed 10 / PDF 18"/>
          <ipd:req id="REQ-078"/>
          <ipd:req id="REQ-070"/>
          <ipd:req id="REQ-071"/>
          <ipd:verify>[verify] E6(R3) A1-1.4.7 frames this as an IRB/IEC written procedure; the party initiating the change is not named</ipd:verify>
          <ipd:verify>[verify] assessment step implied by the immediate-hazard exception in E6R3 A1-2.5.4, A1-1.4.7 and 21 CFR 312.66; no source names it as a separate step</ipd:verify>
        </ipd:trace>
      </bpmn:extensionElements>
